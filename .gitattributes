* text=auto eol=lf
*.cmd text eol=crlf
# Integrity manifests describe exact third-party bytes, including license newlines.
library/**/vendor/** -text
template-library/**/vendor/** -text
# Optional contribution media; small reference images remain ordinary Git assets.
library/templates/catalog/*/source/assets/lfs/** filter=lfs diff=lfs merge=lfs -text

# Optional full-length reference films and standalone template archives.
docs/readme/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
examples/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
library/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
library/**/*.motion filter=lfs diff=lfs merge=lfs -text
