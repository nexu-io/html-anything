{
  "mcpServers": {
    "openmotion": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "mcp.ts"
      ],
      "cwd": ".",
      "env_vars": [
        "MOTION_DATA_DIR",
        "PORT",
        "FFMPEG_PATH",
        "FFPROBE_PATH",
        "HYPERFRAMES_FFMPEG_PATH",
        "HYPERFRAMES_FFPROBE_PATH",
        "HYPERFRAMES_BROWSER_PATH",
        "MOTION_TEMPLATE_ENV",
        "MOTION_TEMPLATE_RESOURCE_ID",
        "MOTION_TEMPLATE_LOCALE"
      ]
    }
  }
}
