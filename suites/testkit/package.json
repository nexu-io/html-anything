  },
  "devDependencies": {
    "@open-motion/daemon": "workspace:*",
    "@open-motion/web": "workspace:*",
    "@types/node": "24.12.2",
    "electron": "41.3.0",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
