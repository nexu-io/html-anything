{
  "name": "@odsuite/electron",
  "version": "0.14.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./preload": "./dist/preload.cjs",
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.mjs"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@odsuite/runtime": "workspace:*",
    "@odsuite/release": "workspace:*",
    "@odsuite/update": "workspace:*",
    "@odsuite/distribution": "workspace:*",
    "@odsuite/installer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6",
    "electron": "41.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nexu-io/html-anything.git",
    "directory": "suites/electron"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "electron": "41.3.0"
  },
  "sideEffects": false,
  "private": true
}
