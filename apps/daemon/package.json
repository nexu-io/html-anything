{
  "name": "@open-motion/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./main": "./dist/main.mjs",
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@odsuite/protocol": "workspace:*",
    "@odsuite/sidecar": "workspace:*",
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "dependencies": {
    "@odsuite/carrier": "workspace:*",
    "@open-motion/workspace": "workspace:*",
    "@open-motion/motion": "workspace:*"
  }
}
