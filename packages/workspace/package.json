{
  "name": "@open-motion/workspace",
  "private": true,
  "type": "module",
  "description": "Canonical product sessions, artifacts and native project revisions",
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "24.12.2",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nexu-io/html-anything.git",
    "directory": "packages/workspace"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.mjs"
    }
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  }
}
