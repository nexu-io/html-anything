{
  "name": "@open-motion/codexplugin",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.6",
    "@types/node": "24.12.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@open-motion/web": "workspace:*",
    "esbuild": "0.28.0",
    "@open-motion/render": "workspace:*",
    "@odsuite/blob": "workspace:*",
    "@odsuite/serve": "workspace:*",
    "@odsuite/pack": "workspace:*",
    "@odsuite/release": "workspace:*"
  },
  "dependencies": {
    "@odsuite/sidecar": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@odsuite/carrier": "workspace:*",
    "@odsuite/protocol": "workspace:*",
    "@open-motion/standalone": "workspace:*",
    "@odsuite/release": "workspace:*",
    "@open-motion/workspace": "workspace:*",
    "@open-motion/daemon": "workspace:*",
    "@odsuite/dev": "workspace:*",
    "@odsuite/installer": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/runtime/index.mjs"
    },
    "./main": "./dist/runtime/main.mjs",
    "./install": {
      "types": "./dist/install/index.d.ts",
      "default": "./dist/install.mjs"
    },
    "./installworker": "./dist/installworker.mjs",
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.mjs"
    }
  }
}
