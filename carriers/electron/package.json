{
  "name": "@open-motion/electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./capsule": {
      "types": "./dist/capsule/index.d.ts",
      "default": "./dist/capsule/index.mjs"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@odsuite/release": "workspace:*",
    "@odsuite/electron": "workspace:*",
    "@odsuite/dev": "workspace:*",
    "@odsuite/carrier": "workspace:*",
    "@open-motion/standalone": "workspace:*"
  },
  "devDependencies": {
    "@open-motion/daemon": "workspace:*",
    "@odsuite/protocol": "workspace:*",
    "@odsuite/sidecar": "workspace:*",
    "@open-motion/web": "workspace:*",
    "@types/node": "24.12.2",
    "electron": "41.3.0",
    "esbuild": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.6",
    "@odsuite/runtime": "workspace:*"
  }
}
