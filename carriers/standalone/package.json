{
  "name": "@open-motion/standalone",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run -c vitest.config.ts",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.6",
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "@odsuite/automation": "workspace:*",
    "@odsuite/pack": "workspace:*",
    "@odsuite/release": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./admission": {
      "types": "./dist/admission.d.ts",
      "default": "./dist/admission.mjs"
    },
    "./main": "./dist/runtime/main.mjs",
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.mjs"
    }
  },
  "dependencies": {
    "@odsuite/carrier": "workspace:*",
    "@odsuite/protocol": "workspace:*",
    "@odsuite/sidecar": "workspace:*",
    "@odsuite/serve": "workspace:*",
    "@odsuite/release": "workspace:*",
    "@open-motion/daemon": "workspace:*",
    "@open-motion/web": "workspace:*",
    "@open-motion/workspace": "workspace:*",
    "@odsuite/dev": "workspace:*",
    "@open-motion/render": "workspace:*",
    "@open-motion/templates": "workspace:*",
    "yaml": "2.9.1",
    "@open-motion/gateway": "workspace:*"
  }
}
